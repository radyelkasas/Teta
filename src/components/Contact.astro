---
import { PHONE, MENU_LINK } from '../data/menu';
import Icon from './Icon.astro';
---
<section class="contact reveal" id="contact" aria-labelledby="contact-title">
  <div class="card">
    <p class="kicker">للاستفسار تواصل</p>
    <a class="number display" href={`tel:${PHONE}`}>
      <span class="num">{PHONE}</span>
    </a>
    <h2 id="contact-title" class="visually-hidden">للاستفسار تواصل {PHONE}</h2>
    <a class="btn btn-primary call" href={`tel:${PHONE}`}>
      <Icon name="phone" />
      اتصل بنا
    </a>
    <a class="pdf" href={MENU_LINK} target="_blank" rel="noopener">
      <Icon name="external" />
      المنيو الأصلي بصيغة PDF
    </a>
  </div>
</section>

<style>
  .contact { margin-top: var(--sp-8); }
  .card {
    display: grid;
    justify-items: center;
    padding: clamp(30px, 8vw, 46px) clamp(20px, 6vw, 34px) clamp(26px, 6vw, 36px);
    border-radius: var(--r-xl);
    background: var(--paper);
    color: var(--ink);
    box-shadow: var(--shadow-panel);
    position: relative;
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 10px;
    border-radius: calc(var(--r-xl) - 8px);
    border: 1.5px solid var(--magenta);
    opacity: 0.42;
    pointer-events: none;
  }
  .kicker {
    font-size: 14.5px;
    font-weight: 500;
    color: var(--ink-2);
  }
  .number {
    margin-top: 6px;
    font-size: clamp(56px, 19vw, 96px);
    line-height: 1.1;
    color: var(--purple);
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color 0.24s var(--ease-out);
  }
  .number:hover { color: var(--magenta-700); }
  .call { width: 100%; max-width: 340px; margin-top: 18px; }
  .pdf {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-top: 14px;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    border-bottom: 1px solid var(--paper-3);
  }
  .pdf:hover { color: var(--magenta-800); border-bottom-color: var(--magenta-800); }
  .pdf :global(svg) { width: 17px; height: 17px; }
</style>
