---
import { Image } from 'astro:assets';
import mark from '../assets/brand/teta-mark.png';
import wordmark from '../assets/brand/teta-wordmark.png';
import Icon from './Icon.astro';
import { PHONE, sections } from '../data/menu';

const firstChips = [...sections.slice(0, 3).map((s) => s.chip), 'التورتة', 'المخبوزات'];

// فهرس حقيقي مبني على المنيو نفسه — عدد الأصناف في كل قسم
const index = [
  ...sections.map((s) => ({ id: s.id, label: s.chip, count: s.items.length })),
  { id: 'torta', label: 'التورتة', count: 3 },
  { id: 'idafat', label: 'اضافات', count: 9 },
];
---

<header class="hero gingham">
  <div class="hero-plate">
    <div class="tinlid">
      <div class="lockup">
      <Image
        class="mark"
        src={mark}
        alt="لوجو تيته — رسمة تيته وهي شايلة الطبق"
        widths={[216, 324]}
        sizes="108px"
        loading="eager"
        fetchpriority="high"
      />
      <h1 class="brand">
        <Image class="wordmark" src={wordmark} alt="تيته" widths={[330, 660]} sizes="(min-width: 700px) 340px, 76vw" loading="eager" fetchpriority="high" />
        <span class="visually-hidden">تيته</span>
      </h1>
      <p class="tagline">الحلو بتاع زمان</p>
      <div class="hairline" aria-hidden="true"></div>
      <p class="lede">
        حلو شرقي بالوزن وحلو غربي بالقطعة، من فرن تيته لخمس فروع.
        المنيو كامل بأسعاره تحت.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="#menu">
          شوف المنيو
          <Icon name="arrow" />
        </a>
        <a class="btn btn-ghost" href={`tel:${PHONE}`}>
          <Icon name="phone" />
          اتصل <span class="num">{PHONE}</span>
        </a>
      </div>
      </div>

      <div class="index">
        <p class="index-title">اللي في المنيو</p>
        <ul role="list">
          {index.map((c) => (
            <li>
              <a href={`#${c.id}`}>
                <span class="index-label">{c.label}</span>
                <span class="leader index-leader" aria-hidden="true"></span>
                <span class="index-count num">{c.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      {[0, 1].map(() => firstChips.map((c) => <span class="ticker-word">{c}</span>))}
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    padding-block: max(20px, env(safe-area-inset-top));
  }

  .hero-plate {
    display: grid;
    place-items: center;
    width: 100%;
    max-width: 640px;
    margin-inline: auto;
    padding: 20px 16px 28px;
  }

  .tinlid {
    position: relative;
    width: 100%;
    display: grid;
    justify-items: center;
    padding: clamp(28px, 7vw, 44px) clamp(20px, 6vw, 40px) clamp(26px, 6vw, 38px);
    border-radius: var(--r-xl);
    background:
      radial-gradient(120% 90% at 50% 0%, #96329D 0%, #85298C 46%, #6F1F76 100%);
    box-shadow:
      0 2px 0 rgba(255, 255, 255, 0.16) inset,
      0 30px 60px -34px rgba(24, 6, 28, 0.95);
  }
  /* الخط المسنن الوردي — حافة علبة الحلو */
  .tinlid::before {
    content: '';
    position: absolute;
    inset: 10px;
    border-radius: calc(var(--r-xl) - 8px);
    border: 1.5px solid var(--magenta);
    opacity: 0.62;
    pointer-events: none;
  }

  .mark {
    width: 108px;
    height: 108px;
    border-radius: 50%;
    box-shadow: 0 10px 26px -12px rgba(24, 6, 28, 0.9);
  }

  .brand {
    margin: 18px 0 0;
    line-height: 0;
  }
  .wordmark {
    width: min(76vw, 340px);
    height: auto;
  }

  /* العربي ما بيتكتبش بتباعد حروف — التمييز هنا بالوزن واللون */
  .tagline {
    margin-top: 16px;
    font-size: clamp(16px, 4.4vw, 18px);
    font-weight: 500;
    color: #F9B6D8;
    line-height: 1.6;
  }

  .hairline {
    width: 64px;
    height: 2px;
    margin-top: 20px;
    border-radius: 2px;
    background: linear-gradient(90deg, transparent, var(--magenta), transparent);
  }

  .lede {
    margin-top: 18px;
    max-width: 34ch;
    text-align: center;
    font-size: clamp(15.5px, 4.2vw, 17px);
    font-weight: 300;
    line-height: 1.95;
    color: var(--on-purple-2);
    text-wrap: balance;
  }

  .actions {
    display: grid;
    gap: 10px;
    width: 100%;
    margin-top: 26px;
  }
  .actions .btn { width: 100%; }

  @media (min-width: 520px) {
    .actions { grid-template-columns: 1.15fr 1fr; }
  }

  /* شريط التصنيفات المتحرك على الحافة السفلى */
  .ticker {
    overflow: hidden;
    border-block: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(42, 14, 47, 0.22);
    padding-block: 11px;
    margin-bottom: max(0px, env(safe-area-inset-bottom));
  }
  .ticker-track {
    display: flex;
    width: max-content;
    gap: 0;
    animation: slide 34s linear infinite;
  }
  .ticker-word {
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.62);
    padding-inline: 26px;
    position: relative;
    white-space: nowrap;
  }
  .ticker-word::after {
    content: '';
    position: absolute;
    inset-inline-start: -4px;
    top: 50%;
    width: 5px;
    height: 5px;
    margin-top: -2.5px;
    border-radius: 50%;
    background: var(--magenta);
  }
  @keyframes slide {
    from { transform: translateX(0); }
    to { transform: translateX(50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker-track { animation: none; }
  }

  .lockup { display: grid; justify-items: center; width: 100%; }

  /* الفهرس — يظهر على الشاشات الأعرض بس */
  .index { display: none; }

  @media (min-width: 900px) {
    .hero-plate { max-width: 1120px; padding-inline: 28px; }
    .tinlid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 330px);
      align-items: center;
      column-gap: clamp(34px, 5vw, 64px);
      padding: 52px clamp(34px, 4vw, 56px);
      justify-items: stretch;
    }
    .mark { width: 132px; height: 132px; }
    .wordmark { width: min(100%, 380px); }
    .lede { max-width: 40ch; }
    .actions { grid-template-columns: 1.1fr 1fr; max-width: 460px; }

    .index {
      display: block;
      padding: 24px 22px 20px;
      border-radius: var(--r-lg);
      background: rgba(24, 6, 28, 0.3);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
    }
    .index-title {
      font-family: var(--font-display);
      font-size: 28px;
      line-height: 1.2;
      color: #fff;
      margin-bottom: 10px;
    }
    .index ul { list-style: none; margin: 0; padding: 0; }
    .index li + li { border-top: 1px solid rgba(255, 255, 255, 0.12); }
    .index a {
      display: flex;
      align-items: baseline;
      min-height: 42px;
      padding-block: 4px;
      font-size: 16px;
      font-weight: 400;
      color: var(--on-purple-2);
      text-decoration: none;
      transition: color 0.2s var(--ease-out);
    }
    .index a:hover { color: #fff; }
    .index-leader { border-bottom-color: rgba(255, 255, 255, 0.3); }
    .index-count { font-weight: 600; color: #fff; font-size: 16px; }
    .index-foot {
      margin-top: 14px;
      font-size: 12.5px;
      font-weight: 300;
      line-height: 1.7;
      color: var(--purple-300);
    }
  }
</style>
