---
import { branches } from '../data/menu';
import Icon from './Icon.astro';
---
<section class="branches reveal" id="branches" aria-labelledby="branches-title">
  <div class="head">
    <h2 class="display" id="branches-title">فروعنا</h2>
    <p>خمس فروع — تعالى لأقرب واحد ليك.</p>
  </div>
  <ul role="list">
    {branches.map((b, i) => (
      <li>
        <a class="branch" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`تيته حلويات ${b.area} ${b.address}`)}`} target="_blank" rel="noopener">
          <span class="no display num">{i + 1}</span>
          <span class="txt">
            <b>{b.area}</b>
            <span>{b.address}</span>
          </span>
          <span class="go" aria-hidden="true"><Icon name="pin" /></span>
          <span class="visually-hidden">افتح على الخريطة</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .branches { margin-top: var(--sp-8); }
  .head { padding-inline: 4px; }
  .head h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(40px, 12vw, 64px);
    line-height: 1.06;
    color: #fff;
  }
  .head p { margin-top: 4px; font-size: 15px; font-weight: 300; color: var(--on-purple-2); }

  ul { list-style: none; margin: 20px 0 0; padding: 0; display: grid; gap: 10px; }

  .branch {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 15px 16px;
    border-radius: var(--r-lg);
    text-decoration: none;
    background: rgba(255, 255, 255, 0.07);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.13);
    transition: background-color 0.24s var(--ease-out), transform 0.24s var(--ease-snap),
      box-shadow 0.24s var(--ease-out);
  }
  .branch:hover {
    background: rgba(255, 255, 255, 0.14);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.3);
    transform: translateY(-2px);
  }
  .no {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--magenta);
    color: #fff;
    font-size: 22px;
    line-height: 1;
  }
  .txt { display: grid; line-height: 1.55; }
  .txt b { font-size: 18px; font-weight: 600; color: #fff; }
  .txt span { font-size: 14.5px; font-weight: 300; color: var(--on-purple-2); }
  .go { display: grid; place-items: center; width: 40px; height: 40px; color: var(--on-purple-2); }
  .go :global(svg) { width: 22px; height: 22px; }
  .branch:hover .go { color: #fff; }

  @media (min-width: 760px) {
    ul { grid-template-columns: 1fr 1fr; }
  }
</style>
