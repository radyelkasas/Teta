---
import '../styles/global.css';
import { PHONE, branches } from '../data/menu';

interface Props { title: string; description: string }
const { title, description } = Astro.props;

const origin = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, origin).toString();
const ogImage = new URL('/og.jpg', origin).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Bakery',
  name: 'تيته',
  slogan: 'الحلو بتاع زمان',
  description,
  telephone: PHONE,
  servesCuisine: 'حلويات شرقية وغربية',
  currenciesAccepted: 'EGP',
  hasMenu: { '@type': 'Menu', name: 'منيو تيته', inLanguage: 'ar-EG' },
  location: branches.map((b) => ({
    '@type': 'Place',
    name: `تيته — ${b.area}`,
    address: { '@type': 'PostalAddress', addressLocality: b.area, streetAddress: b.address, addressCountry: 'EG' },
  })),
};
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#85298C" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />

    <link rel="preload" as="font" type="font/woff2" href="/fonts/readexpro-arabic.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/rakkas-arabic.woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ar_EG" />
    <meta property="og:site_name" content="تيته" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#menu">تخطَّ إلى المنيو</a>
    <slot />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    inset-inline-start: 16px;
    top: -80px;
    z-index: 200;
    padding: 14px 22px;
    border-radius: 999px;
    background: #fff;
    color: #2a0e2f;
    font-weight: 600;
    text-decoration: none;
    transition: top 0.2s ease;
  }
  .skip:focus { top: 16px; }
</style>
